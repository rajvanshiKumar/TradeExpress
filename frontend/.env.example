# TradeSphere Frontend Environment Configuration
# Variables starting with VITE_ are bundled into the client build.

# Backend REST API Base URL
VITE_PUBLIC_API_BASE_URL=http://localhost:5000/api
VITE_PUBLIC_API_PRODUCTS_PATH=products

# Google Sign-In: the OAuth *client ID* only (public). Never put the client secret in a VITE_ variable.
VITE_GOOGLE_CLIENT_ID=

# Optional Admin Credentials prototype (leave blank in development)
VITE_ADMIN_PASSWORD_HASH=
