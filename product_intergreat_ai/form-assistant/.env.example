# --- Required ---
# Secret that your Express backend sends in the X-API-Key header (min 16 chars).
ASSIST_API_KEY=change-me-to-a-long-random-string

# --- AI provider: fake | gemini | openai ---
# "fake" is deterministic and offline (development/test only, refused in production).
ASSIST_AI_PROVIDER=fake
ASSIST_GEMINI_API_KEY=
ASSIST_GEMINI_MODEL=gemini-3.5-flash-lite
ASSIST_OPENAI_API_KEY=
ASSIST_OPENAI_MODEL=gpt-4o-mini

# --- Optional ---
ASSIST_ENVIRONMENT=development
ASSIST_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
ASSIST_RATE_LIMIT_PER_MINUTE=30
