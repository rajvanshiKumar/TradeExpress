# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=tradeexpress_ai
# At least 32 random characters, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
TX_JWT_SECRET=
TX_ENVIRONMENT=development
TX_CORS_ORIGINS=["http://localhost:3000"]
# Role that RLS applies to; the DB user must be allowed to SET ROLE to it (created by migration 0001).
TX_DB_APP_ROLE=tx_app

# --- AI (Milestone 2) ---
TX_AI_PROVIDER=gemini
TX_GEMINI_API_KEY=
TX_GEMINI_MODEL=gemini-3.5-flash-lite
# Optional price table (USD per 1M tokens) to enable cost *estimates* in ai_usage_logs
TX_GEMINI_PRICE_IN_PER_M=
TX_GEMINI_PRICE_OUT_PER_M=
TX_STORAGE_DIR=./storage
