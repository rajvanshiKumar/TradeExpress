datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUYER
  SUPPLIER
  ADMIN
  SUPER_ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  FAILED
  COD
  REFUNDED
}

enum OrderStatus {
  ORDER_PLACED
  ORDER_CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  name                String
  role                Role                 @default(BUYER)
  adminRole           String?              // USER_ADMIN, PRODUCT_ADMIN, VERIFICATION_ADMIN, FINANCE_ADMIN, SUPPORT_ADMIN, CUSTOM
  adminPermissions    Json?                // Array of permission codes
  isActive            Boolean              @default(true)
  status              String               @default("ACTIVE") // ACTIVE, SUSPENDED, DEACTIVATED
  statusReason        String?              @db.Text
  company             String?
  phone               String?
  city                String?
  country             String?              @default("India")
  gstin               String?
  pan                 String?
  bankAccountNumber    String?
  bankIfsc            String?
  bankName            String?
  warehouseAddress    String?              @db.Text
  warehouseState      String?
  warehousePincode    String?
  kycStatus           String?              @default("NOT_SUBMITTED") // NOT_SUBMITTED, PENDING, VERIFIED, REJECTED, RESUBMISSION_REQUESTED
  kycRejectionReason  String?              @db.Text
  isVerified          Boolean              @default(false)
  isPhoneVerified     Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  addresses           Address[]
  orders              Order[]              @relation("BuyerOrders")
  supplierOrders      Order[]              @relation("SupplierOrders")
  carts               Cart[]
  kycDocuments        KycDocument[]
  passwordResetTokens PasswordResetToken[]
  rfqs                Rfq[]                @relation("BuyerRfqs")
  quotations          Quotation[]          @relation("SupplierQuotes")
  disputesRaised      Dispute[]            @relation("BuyerDisputes")
  reviewsWritten      Review[]             @relation("BuyerReviews")
  supportTickets      SupportTicket[]
  notifications       Notification[]
  payouts             SupplierPayout[]
  auditLogs           AuditLog[]           @relation("ActorAuditLogs")
  targetedAuditLogs   AuditLog[]           @relation("TargetAuditLogs")
  conversationsAsBuyer    Conversation[]   @relation("BuyerConversations")
  conversationsAsSupplier Conversation[]   @relation("SupplierConversations")
  sentMessages            Message[]        @relation("UserSentMessages")

  @@map("users")
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Office")
  name       String
  company    String?
  gstin      String?
  phone      String
  street     String
  city       String
  state      String?
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("addresses")
}

model Category {
  id            String    @id @default(uuid())
  slug          String    @unique
  name          String
  description   String?   @db.Text
  photo         String?   @db.Text
  subcategories Json?
  attributes    Json?     // Category-specific attribute definitions
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products      Product[]

  @@map("categories")
}

model Product {
  id               String         @id @default(uuid())
  sku              String         @unique
  name             String
  slug             String         @unique
  companyId        String?
  supplierId       String?
  categorySlug     String
  category         Category       @relation(fields: [categorySlug], references: [slug], onDelete: Restrict)
  subcategory      String?
  summary          String?        @db.Text
  description      String?        @db.Text
  photo            String?        @db.Text
  currency         String         @default("INR")
  price            Decimal        @db.Decimal(12, 2)
  unit             String         @default("piece")
  moq              Int            @default(1)
  stock            Int            @default(100)
  leadTimeDays     Int            @default(7)
  status           String         @default("Active")
  featured         Boolean        @default(false)
  trending         Boolean        @default(false)
  readyToShip      Boolean        @default(true)
  isNew            Boolean        @default(false)
  deal             Boolean        @default(false)
  hsnCode          String?        @default("8471")
  gstRate          Decimal        @default(18.00) @db.Decimal(5, 2)
  sampleAvailable  Boolean        @default(true)
  samplePrice      Decimal?       @db.Decimal(12, 2)
  moderationStatus String         @default("APPROVED") // APPROVED, PENDING, REJECTED
  rejectionReason  String?        @db.Text
  weightKg         Decimal?       @default(1.00) @db.Decimal(8, 2)
  variants         Json?
  specifications   Json?
  packaging        Json?
  priceTiers       Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  images           ProductImage[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  reviews          Review[]
  rfqItems         RfqItem[]
  conversations    Conversation[]

  @@index([categorySlug])
  @@index([status])
  @@index([moderationStatus])
  @@index([companyId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String   @db.Text
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("product_images")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  variant   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cart_items")
}

model Order {
  id                    String               @id @default(uuid())
  orderNumber           String               @unique
  userId                String?
  user                  User?                @relation("BuyerOrders", fields: [userId], references: [id], onDelete: SetNull)
  supplierId            String?
  supplier              User?                @relation("SupplierOrders", fields: [supplierId], references: [id], onDelete: SetNull)
  supplierCompanyId     String?
  supplierInvoiceNumber String?
  buyerName             String
  buyerEmail            String
  buyerPhone            String
  buyerCompany          String?
  buyerGstin            String?
  supplierGstin         String?
  shippingMethod        String               @default("standard")
  shippingEta           String?
  paymentMethod         String               @default("online")
  paymentStatus         PaymentStatus        @default(PENDING)
  orderStatus           OrderStatus          @default(ORDER_PLACED)
  subtotal              Decimal              @db.Decimal(12, 2)
  shippingFee           Decimal              @db.Decimal(12, 2) @default(0)
  tax                   Decimal              @db.Decimal(12, 2) @default(0)
  cgst                  Decimal              @default(0) @db.Decimal(12, 2)
  sgst                  Decimal              @default(0) @db.Decimal(12, 2)
  igst                  Decimal              @default(0) @db.Decimal(12, 2)
  isInterState          Boolean              @default(false)
  discount              Decimal              @db.Decimal(12, 2) @default(0)
  total                 Decimal              @db.Decimal(12, 2)
  isPartialPayment      Boolean              @default(false)
  advanceAmount         Decimal              @default(0) @db.Decimal(12, 2)
  balanceDue            Decimal              @default(0) @db.Decimal(12, 2)
  currency              String               @default("INR")
  deliveryAddress       Json
  idempotencyKey        String?              @unique
  trackingNumber        String?
  carrierName           String?
  invoiceUrl            String?              @db.Text
  ewayBillUrl           String?              @db.Text
  deliveryProofUrl      String?              @db.Text
  rejectionReason       String?              @db.Text
  deliveryAcceptedAt    DateTime?
  notes                 String?              @db.Text
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  items                 OrderItem[]
  payments              Payment[]
  statusHistory         OrderStatusHistory[]
  dispute               Dispute?
  review                Review?
  escrowLedger          EscrowLedger?
  conversations         Conversation[]

  @@index([userId])
  @@index([buyerEmail])
  @@index([supplierId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productSku   String
  productPhoto String?  @db.Text
  hsnCode      String?  @default("8471")
  gstRate      Decimal  @default(18.00) @db.Decimal(5, 2)
  unit         String   @default("piece")
  quantity     Int
  unitPrice    Decimal  @db.Decimal(12, 2)
  lineTotal    Decimal  @db.Decimal(12, 2)
  variant      Json?

  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway        String        @default("razorpay")
  transactionId  String?       @unique
  paymentOrderId String?
  signature      String?
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("INR")
  status         PaymentStatus @default(PENDING)
  rawResponse    Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([orderId])
  @@index([paymentOrderId])
  @@map("payments")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  notes     String?     @db.Text
  changedBy String?     @default("System")
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model KycDocument {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType   String   // GST_CERTIFICATE, PAN_CARD, CANCELLED_CHEQUE, WAREHOUSE_PROOF, BUSINESS_REG, OTHER
  docNumber String?
  fileName  String
  fileUrl   String   @db.Text
  fileSize  Int?
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("kyc_documents")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  otp       String?
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model MobileVerification {
  id             String    @id @default(uuid())
  phone          String    @unique
  otpHash        String?
  token          String?   @unique
  verified       Boolean   @default(false)
  verifiedAt     DateTime?
  attempts       Int       @default(0)
  resendCount    Int       @default(0)
  lastSentAt     DateTime  @default(now())
  expiresAt      DateTime
  tokenExpiresAt DateTime?
  used           Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([phone])
  @@map("mobile_verifications")
}

model CommissionSetting {
  id         String   @id @default(uuid())
  type       String   // GLOBAL, CATEGORY, SUPPLIER
  targetId   String?  // category slug or supplier id (null for GLOBAL)
  percentage Decimal  @default(5.00) @db.Decimal(5, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([type, targetId])
  @@map("commission_settings")
}

model Rfq {
  id                 String      @id @default(uuid())
  rfqNumber          String      @unique
  buyerId            String?
  buyer              User?       @relation("BuyerRfqs", fields: [buyerId], references: [id], onDelete: SetNull)
  buyerName          String
  buyerEmail         String
  buyerCompany       String?
  title              String
  categorySlug       String?
  targetPrice        Decimal?    @db.Decimal(12, 2)
  quantity           Int
  unit               String      @default("piece")
  deliveryPincode    String?
  destinationCountry String      @default("India")
  requiredByDate     DateTime?
  specifications     String      @db.Text
  attachmentUrl      String?     @db.Text
  savedComparison    Json?
  status             String      @default("OPEN") // OPEN, QUOTED, CLOSED, EXPIRED
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  items              RfqItem[]
  quotations         Quotation[]
  conversations      Conversation[]

  @@index([buyerId])
  @@index([categorySlug])
  @@map("rfqs")
}

model RfqItem {
  id          String   @id @default(uuid())
  rfqId       String
  rfq         Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int
  unit        String   @default("piece")
  targetPrice Decimal? @db.Decimal(12, 2)
  notes       String?  @db.Text

  @@map("rfq_items")
}

model Quotation {
  id                   String             @id @default(uuid())
  quoteNumber          String             @unique
  rfqId                String
  rfq                  Rfq                @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId           String
  supplier             User               @relation("SupplierQuotes", fields: [supplierId], references: [id], onDelete: Cascade)
  currency             String             @default("INR")
  unitPrice            Decimal            @db.Decimal(12, 2)
  moq                  Int                @default(1)
  availableQuantity    Int?
  priceBreaks          Json?
  gstPercentage        Decimal            @default(18.00) @db.Decimal(5, 2)
  freightCharge        Decimal            @default(0) @db.Decimal(12, 2)
  otherCharges         Decimal            @default(0) @db.Decimal(12, 2)
  otherChargesDesc     String?
  shippingMethod       String?            @default("Road Express")
  leadTimeDays         Int                @default(14)
  estimatedDeliveryDate DateTime?
  paymentTerms         String?            @default("100% Advance")
  validityDate         DateTime?
  sampleAvailable      Boolean            @default(false)
  sampleCost           Decimal            @default(0) @db.Decimal(12, 2)
  customizationDetails String?            @db.Text
  taxDutyNotes         String?            @db.Text
  notes                String?            @db.Text
  attachmentUrl        String?            @db.Text
  status               String             @default("SENT") // DRAFT, SENT, VIEWED, COUNTERED, ACCEPTED, REJECTED, EXPIRED, WITHDRAWN, CLOSED
  currentVersion       Int                @default(1)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  items                QuoteItem[]
  versions             QuotationVersion[]

  @@index([rfqId])
  @@index([supplierId])
  @@map("quotations")
}

model QuoteItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  lineTotal   Decimal   @db.Decimal(12, 2)

  @@map("quote_items")
}

model QuotationVersion {
  id                String    @id @default(uuid())
  quotationId       String
  quotation         Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  versionNumber     Int
  unitPrice         Decimal   @db.Decimal(12, 2)
  moq               Int?      @default(1)
  availableQuantity Int?
  priceBreaks       Json?
  gstPercentage     Decimal   @db.Decimal(5, 2)
  freightCharge     Decimal   @db.Decimal(12, 2)
  otherCharges      Decimal?  @default(0) @db.Decimal(12, 2)
  otherChargesDesc  String?
  shippingMethod    String?
  leadTimeDays      Int
  paymentTerms      String?
  notes             String?   @db.Text
  proposedBy        String    // SUPPLIER, BUYER
  createdAt         DateTime  @default(now())

  @@index([quotationId])
  @@map("quotation_versions")
}

model Dispute {
  id          String           @id @default(uuid())
  orderId     String           @unique
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User             @relation("BuyerDisputes", fields: [buyerId], references: [id], onDelete: Cascade)
  reason      String
  description String           @db.Text
  photoProof  String?          @db.Text
  status      String           @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED_REFUND, RESOLVED_REJECTED
  resolution  String?          @db.Text
  refundAmount Decimal?        @db.Decimal(12, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  messages    DisputeMessage[]

  @@map("disputes")
}

model DisputeMessage {
  id        String   @id @default(uuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderRole String  // BUYER, SUPPLIER, ADMIN
  message   String   @db.Text
  fileUrl   String?  @db.Text
  createdAt DateTime @default(now())

  @@map("dispute_messages")
}

model EscrowLedger {
  id             String    @id @default(uuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountHeld     Decimal   @db.Decimal(12, 2)
  commissionRate Decimal   @default(5.00) @db.Decimal(5, 2)
  commissionFee  Decimal   @default(0) @db.Decimal(12, 2)
  payoutAmount   Decimal   @db.Decimal(12, 2)
  status         String    @default("HELD") // HELD, RELEASED, REFUNDED
  releasedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("escrow_ledgers")
}

model SupplierPayout {
  id           String    @id @default(uuid())
  supplierId   String
  supplier     User      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount       Decimal   @db.Decimal(12, 2)
  commission   Decimal   @db.Decimal(12, 2)
  status       String    @default("PROCESSED") // PENDING, PROCESSED, FAILED
  reference    String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([supplierId])
  @@map("supplier_payouts")
}

model Review {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  buyerId       String
  buyer         User     @relation("BuyerReviews", fields: [buyerId], references: [id], onDelete: Cascade)
  rating        Int      @default(5)
  qualityRating Int      @default(5)
  packagingRating Int    @default(5)
  timelinessRating Int   @default(5)
  comment       String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  type      String   @default("INFO") // ORDER, RFQ, QUOTE, PAYOUT, SYSTEM
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

model SupportTicket {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  String          @default("GENERAL") // GENERAL, ORDER, BILLING, TECHNICAL
  priority  String          @default("NORMAL")
  status    String          @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  messages  TicketMessage[]

  @@index([userId])
  @@map("support_tickets")
}

model TicketMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderRole String       // USER, ADMIN, SUPER_ADMIN
  message   String        @db.Text
  createdAt DateTime      @default(now())

  @@map("ticket_messages")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  actorRole  String
  action     String   // USER_STATUS_CHANGE, KYC_REVIEW, PRODUCT_MODERATE, COMMISSION_UPDATE, ADMIN_MANAGE, etc.
  resource   String   // USERS, SUPPLIERS, PRODUCTS, ORDERS, PAYMENTS, SETTINGS, ADMINS
  targetId   String?
  targetUser User?    @relation("TargetAuditLogs", fields: [targetId], references: [id], onDelete: SetNull)
  details    Json?
  ipAddress  String?
  userAgent  String?  @db.Text
  result     String   @default("SUCCESS") // SUCCESS, FAILURE
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?  @db.Text
  category    String   @default("GENERAL") // GENERAL, ANNOUNCEMENT, POLICY, INTEGRATION
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("platform_settings")
}

model Conversation {
  id              String        @id @default(uuid())
  buyerId         String
  buyer           User          @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  supplierId      String
  supplier        User          @relation("SupplierConversations", fields: [supplierId], references: [id], onDelete: Cascade)
  companyId       String?
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  rfqId           String?
  rfq             Rfq?          @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subject         String
  unreadBuyer     Int           @default(0)
  unreadSupplier  Int           @default(0)
  lastMessageAt   DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  messages        Message[]

  @@index([buyerId])
  @@index([supplierId])
  @@index([productId])
  @@index([companyId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id              String        @id @default(uuid())
  conversationId  String
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User          @relation("UserSentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderRole      Role
  content         String        @db.Text
  isAutomated     Boolean       @default(false)
  isRead          Boolean       @default(false)
  readAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

