# Environment variables for TradeSphere Backend

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL Connection (Prisma)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# JWT Authentication
JWT_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES"
JWT_EXPIRES_IN="7d"

# Comma-separated exact frontend origins allowed by API and Socket.IO CORS.
# Production example: https://store.example.com,https://admin.example.com
CORS_ORIGINS="http://localhost:5173"

# Payment Gateway (Razorpay Sandbox/Test Mode)
PAYMENT_GATEWAY_MODE="sandbox"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Email Configuration (Nodemailer SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="TradeSphere Marketplace <your-email@gmail.com>"

# SMS Gateway Configuration (PowersText / HTTP Token Key API or MSG91)
SMS_API_URL="https://sms-provider.example.com/api"
SMS_AUTH_KEY="your_sms_gateway_authentic_key"
SMS_SENDER_ID="your_6_char_dlt_sender_id"
SMS_ROUTE="1"
SMS_TEMPLATE_ID="your_dlt_template_id"
SMS_TEMPLATE_MESSAGE="Your OTP for TradeSphere verification is {otp}. Valid for 10 minutes."

# MSG91 Fallback (if using MSG91 API v5 instead)
MSG91_AUTH_KEY="your_msg91_auth_key"
MSG91_TEMPLATE_ID="your_msg91_otp_template_id"
MSG91_OTP_EXPIRY_MINUTES=10
MSG91_OTP_LENGTH=6

# PAN-Aadhaar Link Status Verification API (Provider UAT / PROD)
# Note: Keep credentials strictly server-side. Do NOT expose via Vite frontend variables.
PAN_AADHAAR_API_BASE_URL="https://provider.example.com/v1/pan/aadhaar-link-status"
PAN_AADHAAR_API_ID="your_provider_api_id"
PAN_AADHAAR_API_KEY="your_provider_api_key"
PAN_AADHAAR_TOKEN_ID="your_provider_token_id"
PAN_AADHAAR_API_TIMEOUT_MS=15000

# Google Sign-In (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application")
# The client secret is server-side only. Use the same client ID as VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID="your_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Supplier certificates and ID cards (optional)
# The address printed in supplier QR codes. It is saved when a supplier is first registered, so set it before going live.
PUBLIC_SITE_URL=https://www.tradeexpress.in
SUPPORT_EMAIL=support@tradeexpress.in
